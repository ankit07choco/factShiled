# Web and image-origin checks use local Ollama; no AI/search API keys are needed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
TESSERACT_CMD=

# Anonymous guest access is enabled by default. Configure all three values to enable admin login.
FACTSHIELD_ADMIN_USERNAME=
FACTSHIELD_ADMIN_PASSWORD=
FACTSHIELD_SESSION_SECRET=
FACTSHIELD_SESSION_COOKIE_SECURE=false
FACTSHIELD_DATABASE_PATH=data/factshield_verifications.sqlite3

# Optional Meta WhatsApp Cloud API settings.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v26.0
